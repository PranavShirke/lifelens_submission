# LifeLens Environment Configuration
# This file mirrors the root .env settings.

GROQ_API_KEY=
GEMINI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
# Optional avatar local Qdrant overrides (only needed if not using QDRANT_URL)
# QDRANT_MODE=local
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_PATH=qdrant_storage
# AVATAR_FACES_COLLECTION=lifelens_avatar_faces
# AVATAR_OBJECTS_COLLECTION=lifelens_avatar_objects
# AVATAR_PATIENTS_COLLECTION=lifelens_avatar_patients
# AVATAR_KNOWLEDGE_COLLECTION=lifelens_avatar_text_knowledge

# Optional YOLO path override for object tracking/enrollment.
# If omitted, backend searches common local locations and then falls back to "yolov8n.pt".
# YOLO_MODEL_PATH=

# Optional voice-clone extension point.
# Default "sample" returns stored familiar voice sample playback.
# Set provider to "http" and endpoint to enable external cloning service.
# AVATAR_VOICE_CLONE_PROVIDER=sample
# AVATAR_VOICE_CLONE_ENDPOINT=
# AVATAR_VOICE_CLONE_TIMEOUT_MS=8000
JWT_SECRET=lifelens_super_secret_key_2025
NTFY_TOPIC_URL=https://ntfy.sh/lifelens-caregiver-alerts
